#!/usr/bin/env node

// Historical compatibility command. `openfork` owns binary resolution; this
// shim deliberately has no independent fallback to stock OpenCode runtimes.
//
// Keep this a transparent forward so existing OpenFork scripts that still use
// the historical command name do not silently enter a consumer-specific
// compatibility profile. T3 Code uses the explicit `openfork-t3code` launcher.
await import("./openfork")
