{
  "name": "OpenFork Mobile",
  "short_name": "OpenFork",
  "description": "A separate mobile client for OpenFork",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#101317",
  "background_color": "#101317",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
