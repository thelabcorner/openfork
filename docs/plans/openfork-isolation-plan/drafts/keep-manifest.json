{
  "name": "openfork",
  "upstream": "https://github.com/anomalyco/opencode.git",
  "origin": "https://github.com/thelabcorner/openfork.git",
  "defaultBranch": "main",
  "sync": "tags",
  "stage": "prune-main",
  "workspace": [
    "packages/app",
    "packages/client",
    "packages/codemode",
    "packages/core",
    "packages/desktop",
    "packages/effect-drizzle-sqlite",
    "packages/effect-sqlite-node",
    "packages/http-recorder",
    "packages/httpapi-codegen",
    "packages/llm",
    "packages/opencode",
    "packages/plugin",
    "packages/protocol",
    "packages/schema",
    "packages/script",
    "packages/sdk/js",
    "packages/server",
    "packages/session-ui",
    "packages/ui"
  ],
  "dropFromWorkspace": [
    "packages/cli",
    "packages/console",
    "packages/enterprise",
    "packages/function",
    "packages/sdk-next",
    "packages/slack",
    "packages/stats",
    "packages/storybook",
    "packages/tui",
    "packages/web"
  ],
  "dropConcern": [
    "infra",
    "sst.config.ts",
    "sst-env.d.ts",
    "github",
    "sdks",
    "packages/docs",
    "packages/identity",
    "packages/containers"
  ],
  "doNotRewriteHistory": true,
  "pruneFromMain": [
    "packages/cli",
    "packages/console",
    "packages/containers",
    "packages/docs",
    "packages/enterprise",
    "packages/function",
    "packages/identity",
    "packages/sdk-next",
    "packages/slack",
    "packages/stats",
    "packages/storybook",
    "packages/tui",
    "packages/web",
    "infra",
    "sst.config.ts",
    "sst-env.d.ts",
    "github",
    "sdks",
    "nix",
    "flake.nix",
    "flake.lock",
    "install"
  ],
  "tui": "inline-three-utils-then-prune"
}
