<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="desktop dev" type="js.build_tools.npm">
    <package-json value="$PROJECT_DIR$/packages/desktop/package.json" />
    <command value="run" />
    <scripts>
      <script value="dev" />
    </scripts>
    <node-interpreter value="project" />
    <envs>
      <!-- Do not override OPENCODE_DB here. The openfork/main installation channel
           resolves to opencode-main.db; hard-coding a recovery filename silently
           sends the desktop to a different database than the rest of openfork. -->
      <!-- ChunkDB production posture: hot writes remain plain TEXT; semantic pruning
           is default-on (set OPENCODE_SEAL_PRUNE=0/false as an emergency kill switch),
           then the background sealer keeps a 256-event live tail and applies
           aggregate-scoped exact-value dedup + ratio-first cold compression. Worker
           compression keeps seal CPU off the main thread. Delta-ref remains
           experimental/default-off: real-corpus research found exact-value dedup
           dominates semantic deltas, while delta adds a base lookup/reconstruction
           to the interactive read path. -->
      <env name="OPENCODE_SEAL_ENABLED" value="true" />
      <env name="OPENCODE_SEAL_DEDUP" value="true" />
      <env name="OPENCODE_SEAL_WORKERS" value="true" />
      <env name="OPENCODE_SEAL_BACKFILL" value="true" />
      <env name="OPENCODE_SEAL_DELTA" value="false" />
    </envs>
    <method v="2" />
  </configuration>
</component>
