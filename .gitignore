startup-investigation/raw/*cpuprofile-summary.txt

workbuddy-usage-forensics.tar.br
*.tar.br
.opencode.json

# Legacy repo-local OpenCode namespace. Canonical fork-owned source lives in
# `.openfork/`; any remaining `.opencode/` content is migration residue only.
.opencode/

