# Local dev files
opencode-dev
# Mobile PWA <-> desktop sidecar dev binding. Machine-local and per-launch:
# committing it resurrects a dead port on every checkout, which is how the PWA
# used to end up bound to an unrelated opencode instance.
packages/mobile/.opencode-dev-handshake.json
packages/mobile/.opencode-dev-handshake.json.*.tmp
packages/mobile/.opencode-dev-url
# A real (if loopback-scoped) device credential, minted once and reused across
# restarts. Machine-local; committing it would hand every checkout a standing
# token for someone else's sidecar.
packages/mobile/.opencode-dev-agent-token.json
packages/mobile/.opencode-dev-agent-token.json.*.tmp
UPCOMING_CHANGELOG.md
logs/
*.bun-build
tsconfig.tsbuildinfo

# Agent swarm databases (local-only, never commit)
.openfork/swarms/*.chunkdb*
.opencode/swarms/*.chunkdb*
# Unified file indexes now live in Global.data/file-index/ (SQLite + JSON).
# Repo-local file-index artifacts are derived caches, not source. `.opencode`
# entries are retained only to ignore leftovers from pre-OpenFork layouts.
.openfork/file-index*
.openfork/*.br
.opencode/file-index*
.opencode/*.br

# Local run artifacts (probe/e2e/profiling output)
*.log
*.cpuprofile
packages/app/cdp-screenshot.png
